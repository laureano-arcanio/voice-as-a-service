# Stack de Atentina en el arranque: compose, túnel, trunks SIP y calentamiento del TTS (deploy/boot.sh).
[Unit]
Description=Atentina: stack (compose, túnel, SIP, TTS)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@REPO@/deploy/boot.sh
# Peor caso de boot.sh: 15+5 min de compose, ~8 de trunks SIP, 5 de espera del TTS y 2 de calentamiento.
TimeoutStartSec=2400

[Install]
WantedBy=multi-user.target
