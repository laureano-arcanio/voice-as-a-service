---
import AssistantChat from "../components/AssistantChat.astro";
import Button from "../components/Button.astro";
import CheckList from "../components/CheckList.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Section from "../components/Section.astro";
import Base from "../layouts/Base.astro";

// Agente personal: trabaja para el dueño y su equipo, no atiende clientes. Es el motor assistant con las apps por cliente
// (docs/APPS.md): canal con texto, audio y archivos (OCR), herramientas de la app (que puede envolver el software o la API
// que el cliente ya usa, o ser una app a medida), confirmación antes de cada cambio, links firmados a vistas y formularios,
// envíos por el outbox, avisos programados (jobs) y operadores autorizados.
const features = [
  { title: "Entiende audios, texto y fotos", text: "Hablale como a alguien de tu equipo, o mandale la foto de un comprobante." },
  { title: "Consulta y registra", text: "Clientes, cobros, agenda o stock: lo que maneje tu software." },
  { title: "Confirma antes de cada cambio", text: "Te muestra lo que va a hacer y espera tu sí." },
  { title: "Te manda links", text: "Cuando una pantalla sirve más que un audio: reportes, fichas y formularios que se abren en el celular." },
  { title: "Manda mensajes por vos", text: "Recordatorios y avisos a quien le indiques." },
  { title: "Te escribe solo", text: "El resumen del día o los vencimientos, a la hora que elijas." },
  { title: "Solo para vos y tu equipo", text: "Responde únicamente a los números que autorizás. No atiende al público." },
];

const software = [
  { label: "Lo que ya usás", title: "Tu sistema de gestión", text: "El software con el que ya trabajás. Si tiene API o se puede integrar, el agente lo opera como lo harías vos." },
  { label: "Por API", title: "Cualquier servicio con API", text: "Facturación, agenda, stock o cobros: si tiene una API, el agente la consulta y la usa." },
  { label: "A medida", title: "Una app chica para lo que falta", text: "Si no tenés sistema o el tuyo no lo cubre, armamos un micro software con tus datos, sus vistas y formularios." },
];

const steps = [
  { title: "Nos contás tu día", text: "Qué consultás, qué cargás y qué repetís todos los días." },
  { title: "Lo conectamos a tu software", text: "Al sistema que ya usás o a su API. Si no hay, armamos una app chica con tus datos." },
  { title: "Lo usás desde WhatsApp", text: "Le mandás un audio, como a alguien de tu equipo." },
];

const facts = ["Para vos y tu equipo", "Controlado por voz", "Tu software o una app a medida", "Servidores en Argentina"];
---

<Base
  title="Agente personal: tu software, controlado por voz | Atentina"
  description="Un agente personal con IA para el movimiento diario de tu negocio: le mandás un audio por WhatsApp y lo hace en tu software, el que ya usás, una API o una app a medida. Para vos y tu equipo, no para atender clientes."
  ogDescription="Un agente personal: tu software, controlado por voz."
  path="/asistentes"
>
  <Nav current="asist" />

  <header class="border-b border-line bg-linear-to-b from-bg-2 to-bg pt-10 pb-14 min-[901px]:pt-[72px]">
    <div class="mx-auto grid max-w-[1120px] items-center gap-9 px-5 min-[901px]:grid-cols-[1fr_minmax(0,440px)] min-[901px]:gap-14">
      <div class="grid gap-[22px]">
        <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">Asistentes personales</span>
        <h1>
          Un agente personal para todo el <span class="text-accent">movimiento diario</span>
        </h1>
        <p class="font-display text-[clamp(1.2rem,2vw,1.5rem)] leading-[1.2] font-bold tracking-[-0.015em]">Tu software, controlado por voz.</p>
        <p class="max-w-[62ch] text-[1.12rem] text-ink-2">
          Es para vos y tu equipo, no para tus clientes. Le mandás un audio por WhatsApp y lo hace en tu software: <span class="text-accent">el sistema que ya usás, una API o una app a medida</span>. Consulta, registra y te manda el link a lo que necesitás ver.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <Button href="#demo">Quiero mi agente personal</Button>
          <Button href="#software" variant="ghost">Ver cómo se conecta</Button>
        </div>
        <ul class="m-0 grid list-none grid-cols-2 gap-x-5 gap-y-1.5 p-0 font-mono text-[.76rem] tracking-[.03em] text-muted min-[561px]:flex min-[561px]:flex-wrap">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <AssistantChat />
    </div>
  </header>

  <Section id="software" class="border-b border-line bg-bg-2">
    <h2>Habla con tu software</h2>
    <p class="mt-3 max-w-[62ch] text-[1.12rem] text-ink-2">
      El agente no trae un sistema propio: usa el tuyo. Se conecta a lo que ya tenés o a una app que armamos para vos, y vos lo manejás hablando.
    </p>
    <div class="mt-9 grid gap-4 min-[801px]:grid-cols-3">
      {
        software.map((s) => (
          <div class="grid content-start gap-3 rounded-2xl border border-line bg-surface p-6">
            <span class="font-mono text-[.78rem] tracking-[.04em] text-muted uppercase">{s.label}</span>
            <h3 class="text-[1.2rem]">{s.title}</h3>
            <p class="text-[.96rem] text-ink-2">{s.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="como" class="border-b border-line">
    <div class="grid items-start gap-7 min-[901px]:grid-cols-2 min-[901px]:gap-12">
      <div class="grid gap-4">
        <h2>Lo que hacés en la pantalla, dicho en un audio</h2>
        <p class="max-w-[62ch] text-[1.12rem] text-ink-2">
          Consultar, cargar, buscar un dato, mandar un recordatorio: el movimiento de todos los días, sin abrir la computadora. Lo que consulta son tus datos reales y lo que registra queda en tu software, como si lo hubieras cargado vos.
        </p>
      </div>
      <CheckList items={features} />
    </div>
  </Section>

  <Section>
    <h2>Cómo empieza</h2>
    <ol class="mt-9 grid list-none gap-4 p-0 min-[801px]:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="grid content-start gap-3 rounded-2xl border border-line bg-surface p-6">
            <span class="grid size-9 place-items-center rounded-full bg-accent font-display font-extrabold text-accent-ink">{i + 1}</span>
            <h3 class="text-[1.2rem]">{step.title}</h3>
            <p class="text-[.96rem] text-ink-2">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Cta
    eyebrow="Agente personal"
    title="Contanos tu movimiento diario"
    lead="Nos contás qué software usás y qué hacés todos los días, y te mostramos el agente personal con tu caso. Sin costo y sin compromiso."
    subject="Quiero un agente personal"
    question="¿Qué le pedirías a tu agente?"
    placeholder="Por ejemplo: saber quién debe la cuota y mandarle un recordatorio"
    submit="Pedir una demo"
  />
  <Footer />
</Base>
