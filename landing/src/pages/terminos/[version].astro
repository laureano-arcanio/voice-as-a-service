---
// Cada versión publicada, con su link permanente (data/legal.ts).
import LegalDoc from "../../components/LegalDoc.astro";
import { legal } from "../../data/legal";

export function getStaticPaths() {
  return legal.terminos.versions.map((v) => ({ params: { version: v.version } }));
}

const { version } = Astro.params;
---

<LegalDoc slug="terminos" version={version} description={`${legal.terminos.title}, versión ${version}.`} />
