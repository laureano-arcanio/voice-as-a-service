---
import ApiSection from "../components/ApiSection.astro";
import Button from "../components/Button.astro";
import CodeTabs from "../components/CodeTabs.astro";
import Cta from "../components/Cta.astro";
import Developers from "../components/Developers.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Platform from "../components/Platform.astro";
import Pricing from "../components/Pricing.astro";
import Voices from "../components/Voices.astro";
import Base from "../layouts/Base.astro";

const facts = ["Compatible con OpenAI", "Streaming de texto y audio", "Más de 30 voces argentinas", "Servidores en Argentina"];
---

<Base
  title="Atentina: telefonía, agentes y voz con IA para integrar en tu producto"
  description="LLM, transcripción y síntesis de voz con acento argentino por API, y agentes con telefonía y WhatsApp. Propios, en servidores en Argentina, con un plan gratis para empezar."
  ogDescription="LLM, voz y telefonía por API, con acento argentino. Plan gratis."
  path="/"
>
  <Nav current="home" />

  <header class="border-b border-line bg-linear-to-b from-bg-2 to-bg pt-10 pb-14 min-[901px]:pt-[72px]">
    <div class="mx-auto grid max-w-[1120px] items-center gap-9 px-5 min-[901px]:grid-cols-[.9fr_1.1fr] min-[901px]:gap-12">
      <div class="grid gap-[22px]">
        <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">Para integradores</span>
        <h1>
          Telefonía, agentes y voz con IA para <span class="text-accent">integrar en tu producto</span>
        </h1>
        <p class="max-w-[62ch] text-[1.12rem] text-ink-2">
          Reconocimiento de voz, modelo de lenguaje y síntesis con acento argentino, propios y en servidores en Argentina. Usalos por API, o armá agentes con número y WhatsApp desde nuestra app.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <Button href="#demo" data-demo-link>Empezar gratis</Button>
          <Button href="#api" variant="ghost">Ver la API</Button>
        </div>
        <ul class="m-0 grid list-none grid-cols-2 gap-x-5 gap-y-1.5 p-0 font-mono text-[.76rem] tracking-[.03em] text-muted min-[561px]:flex min-[561px]:flex-wrap">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <CodeTabs />
    </div>
  </header>

  <Platform />
  <ApiSection />
  <Voices />
  <Pricing free />
  <Developers />
  <Cta
    eyebrow="Acceso"
    title="Probá la API con tu caso"
    lead="Contanos qué querés construir y te damos acceso al plan Free. Si necesitás telefonía o un agente armado, lo vemos juntos."
    subject="Quiero acceso a la API de Atentina"
    question="¿Qué querés construir?"
    placeholder="Por ejemplo: un asistente de voz para el sistema de turnos de mis clientes"
    submit="Pedir acceso"
  />
  <Footer />
</Base>
