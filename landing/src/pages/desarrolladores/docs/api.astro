// Documentación pública de la API (/desarrolladores/docs/api; el índice, en data/docs-nav.ts). Inferencia: sale de docs/API_INFERENCIA.md, sin lo que es solo para quien opera el
// server. Llamadas, contactos y campañas: de docs/LLAMADAS_SALIENTES_PLAN.md y app/api/schemas.py. Equipo,
// derivaciones y eventos: de docs/DERIVACIONES_PLAN.md. Qué incluye cada plan: los tiers de la migración 0026 (al
// cambiar un tier, cambiar planFeatures y las tarjetas de data/site.ts). La referencia completa de pedidos y
// respuestas es el OpenAPI del panel (/api/v1/docs). "Cómo funciona" está en la portada (docs/index.astro).
// "Tu propio LLM": de docs/BYOK_LLM_PLAN.md (al cambiarlo, revisar también /privacidad). "Tu propio agente" tiene
// su página (/desarrolladores/docs/tu-propio-agente, docs/AGENTE_EXTERNO_PLAN.md).
import CodeBlock from "../../../components/CodeBlock.astro";
import Cta from "../../../components/Cta.astro";
import { endpoints } from "../../../data/site";
import YouTube from "../../../components/YouTube.astro";
import DocsPage from "../../../layouts/DocsPage.astro";

const BASE = "https://app.atentina.com.ar/api/v1/inference";
const API = "https://app.atentina.com.ar/api/v1";


const sdk = `from openai import OpenAI

client = OpenAI(base_url="${BASE}", api_key="vaas_...")

chat = client.chat.completions.create(
    model="atentina",  # obligatorio en el SDK, pero se ignora
    messages=[{"role": "user", "content": "Hola"}],
)
print(chat.choices[0].message.content)`;

const llm = `curl ${BASE}/chat/completions \\
  -H "Authorization: Bearer $ATENTINA_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"messages":[{"role":"user","content":"Hola, ¿qué horarios tienen?"}],"max_tokens":200}'`;

const stt = `curl ${BASE}/audio/transcriptions \\
  -H "Authorization: Bearer $ATENTINA_KEY" \\
  -F file=@audio.wav -F language=es`;

const tts = `curl ${BASE}/audio/speech \\
  -H "Authorization: Bearer $ATENTINA_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"voice":"sofia","input":"Hola, ¿en qué te puedo ayudar?"}' \\
  --output respuesta.wav`;

const stream = `curl -N ${BASE}/chat/completions \\
  -H "Authorization: Bearer $ATENTINA_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"stream": true, "max_tokens": 200, "messages": [{"role": "user", "content": "Contame algo breve"}]}'`;

const ttsStream = `# Escuchar mientras se sintetiza (ffplay viene con ffmpeg)
curl -sN ${BASE}/audio/speech \\
  -H "Authorization: Bearer $ATENTINA_KEY" -H "Content-Type: application/json" \\
  -d '{"voice":"sofia","input":"Hola, ¿en qué te puedo ayudar?","response_format":"pcm"}' \\
  | ffplay -f s16le -ar 24000 -ac 1 -nodisp -autoexit -`;

const usage = `curl ${BASE}/usage -H "Authorization: Bearer $ATENTINA_KEY"`;

const scopes = [
  { scope: "llm", text: "POST /chat/completions" },
