---
// Registro autoservicio (docs/SUSCRIPCIONES_PLAN.md): crea la cuenta en el plan gratuito y manda el mail
// para activarla. Con ?plan=<nombre> (desde los precios), al activar la cuenta abre ese plan en el panel.
import Button from "../components/Button.astro";
import CheckList from "../components/CheckList.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Nav from "../components/Nav.astro";
import { whatsappUrl } from "../data/site";
import Base from "../layouts/Base.astro";

const label = "grid gap-1.5 text-[.85rem] font-medium text-ink-2";
const field =
  "w-full rounded-xl border border-line bg-bg-2 px-3 py-2.5 font-body text-base text-ink hover:border-line-2 focus:border-accent focus:bg-surface focus:outline-none";
const included = [
  { title: "20 minutos por mes", text: "Para probar tus agentes con llamadas web." },
  { title: "El panel completo", text: "Armá agentes, elegí la voz y mirá cada conversación con sus datos." },
  { title: "La API", text: "LLM, transcripción y voces argentinas, compatible con OpenAI." },
  { title: "Sin tarjeta", text: "Cuando necesites telefonía, elegís un plan desde el panel." },
];
---

<Base
  title="Creá tu cuenta gratis · Atentina"
  description="Registrate gratis en Atentina: armá tu agente, probalo con llamadas web y usá la API. Sin tarjeta."
  path="/registro"
>
  <Nav />

  <header class="border-b border-line bg-linear-to-b from-bg-2 to-bg pt-10 pb-14 min-[901px]:pt-[72px]">
    <!-- Desktop: texto y lista a la izquierda, formulario a la derecha. Mobile: el formulario va antes de la lista. -->
    <div class="mx-auto grid max-w-[1120px] items-start gap-9 px-5 min-[901px]:grid-cols-[1fr_minmax(0,520px)] min-[901px]:gap-x-12">
      <div class="grid gap-[22px]">
        <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">Plan Free</span>
        <h1>Creá tu cuenta <span class="text-accent">gratis</span></h1>
        <p class="max-w-[62ch] text-[1.12rem] text-ink-2">
          Te mandamos un mail para crear tu clave y entrás al panel. Empezás en el plan gratuito y, cuando quieras, pasás a un plan con números y minutos.
        </p>
      </div>

      <div
        class="group/signup overflow-hidden rounded-[18px] border border-line bg-surface shadow-card min-[901px]:col-start-2 min-[901px]:row-span-2 min-[901px]:row-start-1"
        data-signup
        data-state="idle"
      >
        <form class="grid gap-3 p-5 group-data-[state=sent]/signup:hidden" data-signup-form>
          <p class="rounded-xl bg-accent-soft px-3 py-2 text-[.92rem] text-ink-2" data-signup-plan hidden>
            Plan elegido: <b class="font-semibold text-accent"></b>. Lo pagás desde el panel después de activar la cuenta.
          </p>
          <label class={label}>
            Empresa
            <input class={field} name="company" autocomplete="organization" required maxlength="120" placeholder="Clínica San Martín" />
          </label>
          <label class={label}>
            Tu nombre
            <input class={field} name="name" autocomplete="name" required maxlength="120" />
          </label>
          <label class={label}>
            Email
            <input class={field} name="email" type="email" autocomplete="email" required maxlength="254" placeholder="vos@empresa.com" />
          </label>
          <div class="hidden" aria-hidden="true">
            <label>Sitio web <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <Button type="submit" data-signup-submit class="mt-1">
            <span class="group-data-[state=sending]/signup:hidden">Crear mi cuenta</span>
            <span class="hidden group-data-[state=sending]/signup:inline">Creando…</span>
          </Button>
          <p class="text-[.85rem] text-muted">
            Al crear la cuenta aceptás los <a class="text-ink-2" href="/terminos">términos</a> y la{" "}
            <a class="text-ink-2" href="/privacidad">política de privacidad</a>. ¿Ya tenés cuenta?{" "}
            <a class="font-semibold text-accent no-underline hover:text-accent-2" href="https://app.atentina.com.ar/login">Ingresá</a>.
          </p>
          <p class="min-h-[1.3em] text-[.82rem] font-medium text-warn" data-signup-error aria-live="polite"></p>
        </form>

        <div class="hidden justify-items-center gap-2 p-8 text-center group-data-[state=sent]/signup:grid" role="status" tabindex="-1" data-signup-sent>
          <span class="grid size-10 place-items-center rounded-full bg-ok-soft text-ok" aria-hidden="true">
            <Icon name="check" class="size-5" />
          </span>
          <h2 class="text-[1.4rem]">Revisá tu email</h2>
          <p class="text-[.96rem] text-ink-2">
            Te mandamos a <b class="font-semibold" data-signup-email></b> el link para crear tu clave. Vale 72 horas. Si no llega en unos minutos, mirá en spam.
          </p>
          <Button href={whatsappUrl} variant="ghost" target="_blank" rel="noopener" class="mt-2">¿No llegó? Escribinos</Button>
        </div>
      </div>

      <div class="min-[901px]:col-start-1 min-[901px]:row-start-2">
        <CheckList items={included} />
      </div>
    </div>
  </header>

  <Footer />
</Base>

<script>
  import { initSignupForm } from "../scripts/signup";

  document.querySelectorAll<HTMLElement>("[data-signup]").forEach(initSignupForm);
</script>
