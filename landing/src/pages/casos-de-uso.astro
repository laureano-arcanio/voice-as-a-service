---
import CallWidget from "../components/CallWidget.astro";
import CheckList from "../components/CheckList.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Pricing from "../components/Pricing.astro";
import Section from "../components/Section.astro";
import Solutions from "../components/Solutions.astro";
import TelDialog from "../components/TelDialog.astro";
import { atentinaAgent, whatsappUrl } from "../data/site";
import Base from "../layouts/Base.astro";

const features = [
  { title: "Número argentino", text: "Uno nuevo o tu línea de siempre. Entrantes y salientes." },
  { title: "Voces argentinas", text: "Más de 30, masculinas y femeninas. Se cambian cuando quieras." },
  { title: "Integración con WhatsApp", text: "El mismo agente responde por WhatsApp, con texto y notas de voz." },
  { title: "Panel de conversaciones", text: "Transcripción, datos tomados y resultado de cada llamada y chat." },
  { title: "API y webhooks", text: "Creás llamadas y campañas, y recibís cada resultado en tu sistema." },
  { title: "Integración con tu gestión", text: "El agente consulta y escribe en tu sistema durante la llamada." },
  { title: "Derivación a una persona", text: "Si lo supera, toma el dato y avisa a tu equipo." },
];
---

<Base
  title="Casos de uso: agentes con IA que atienden a los clientes de tu empresa | Atentina"
  description="Agentes con inteligencia artificial que atienden a tus clientes por teléfono y WhatsApp. Voces argentinas y precio fijo en pesos."
  ogDescription="Atienden por teléfono y WhatsApp. Voz argentina y precio en pesos."
  path="/casos-de-uso"
>
  <Nav current="casos" />

  <header class="border-b border-line bg-linear-to-b from-bg-2 to-bg pt-10 pb-14 min-[901px]:pt-[72px]">
    <div class="mx-auto grid max-w-[1120px] items-center gap-9 px-5 min-[901px]:grid-cols-[1fr_380px] min-[901px]:gap-12">
      <div class="grid gap-[22px]">
        <h1>
          Los agentes de atención para tu empresa, más <span class="text-accent">inteligentes</span> y <span class="text-accent">rápidos</span> del mercado
        </h1>
        <p class="font-display text-[clamp(1.2rem,2vw,1.5rem)] leading-[1.2] font-bold tracking-[-0.015em] min-[901px]:my-[18px]">
          A un <a class="text-accent decoration-2 underline-offset-4 hover:text-accent-2" href="#precios">precio argentino</a>.
        </p>
        <p class="max-w-[62ch] text-[1.12rem] text-ink-2">
          Atienden consultas, dan turnos, confirman, recuerdan vencimientos y cobran. Con voces argentinas y con un precio fijo en pesos.
        </p>
        {/* En mobile no va: lo repite "Nuestro producto", justo debajo, y empuja la demo fuera del primer pantallazo. */}
        <p class="hidden max-w-[62ch] text-[1.12rem] text-ink-2 min-[901px]:block">
          <span class="text-accent">Un solo servicio que integra todo lo que necesitás</span>: telefonía, voces e inteligencia artificial incluidas. Lo contratás y empieza a atender.
        </p>
      </div>
      <CallWidget agents={[atentinaAgent]} whatsapp={whatsappUrl} others="#soluciones" />
    </div>
  </header>

  <TelDialog />

  <Section id="como">
    <div class="grid items-start gap-7 min-[901px]:grid-cols-2 min-[901px]:gap-12">
      <div class="grid gap-4">
        <h2>Nuestro producto</h2>
        <p class="max-w-[62ch] text-[1.12rem] text-ink-2">
          Todo lo necesario para automatizar la atención por teléfono y por WhatsApp de tu empresa, en un solo servicio: número argentino, varias llamadas a la vez, WhatsApp e inteligencia artificial incluida. <span class="text-accent">No necesitás contratar telefonía ni combinar proveedores</span>: lo contratás y empieza a atender.
        </p>
      </div>
      <CheckList items={features} />
    </div>
  </Section>

  <Solutions />
  <Pricing free />
  <Faq />
  <Cta />
  <Footer />
</Base>
