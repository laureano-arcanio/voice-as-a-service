---
// Página de la documentación (/desarrolladores/docs, /docs/mcp, /docs/api y /docs/tu-propio-agente): encabezado, la navegación de
// data/docs-nav.ts al costado (en el celular, plegada arriba) y el contenido con los estilos de texto, listas, código
// y tablas (.docs). En la portada se ven todas las secciones; en MCP y API, las de esa página y el título de las otras.
import DocsNav from "../components/DocsNav.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { docsNav, type DocsGroup } from "../data/docs-nav";
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  path: string;
  schema?: object[];
  page: DocsGroup["key"];
  eyebrow: string;
  heading: string;
  lead: string;
}

const { title, description, ogDescription, path, schema, page, eyebrow, heading, lead } = Astro.props;
const hub = page === "intro";
const groups = docsNav.map((g) => ({
  ...g,
  current: g.key === page,
  sections: hub || g.key === page ? g.sections : [],
  link: (id: string) => (g.key === page ? `#${id}` : `${g.href}#${id}`),
}));
---

<Base title={title} description={description} ogDescription={ogDescription} path={path} schema={schema}>
  <Nav current="docs" />

  <header class="border-b border-line bg-linear-to-b from-bg-2 to-bg pt-10 pb-10 min-[901px]:pt-[72px]">
    <div class="mx-auto grid max-w-[1120px] gap-4 px-5">
      <a class="w-fit text-[.9rem] font-semibold text-muted no-underline hover:text-ink" href={hub ? "/desarrolladores" : "/desarrolladores/docs"}>
        ← {hub ? "Desarrolladores" : "Documentación"}
      </a>
      <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">{eyebrow}</span>
      <h1>{heading}</h1>
      <p class="max-w-[62ch] text-[1.12rem] text-ink-2">{lead}</p>
      <slot name="header" />
    </div>
  </header>

  <div class="mx-auto grid max-w-[1120px] gap-8 px-5 py-12 min-[901px]:grid-cols-[220px_minmax(0,1fr)] min-[901px]:gap-14 min-[901px]:py-[76px]">
    <aside class="min-[901px]:sticky min-[901px]:top-[96px] min-[901px]:max-h-[calc(100vh-120px)] min-[901px]:self-start min-[901px]:overflow-y-auto">
      <div class="hidden min-[901px]:block"><DocsNav groups={groups} /></div>
      <details class="group rounded-xl border border-line bg-surface min-[901px]:hidden" open={hub}>
        <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
          <span aria-hidden="true" class="font-mono text-muted transition-transform duration-150 group-open:rotate-90 motion-reduce:transition-none">›</span>
          Índice de la documentación
        </summary>
        <div class="px-4 pb-4"><DocsNav groups={groups} /></div>
      </details>
    </aside>

    <main class="docs grid min-w-0 gap-12 text-ink-2">
      <slot />
    </main>
  </div>

  <slot name="after" />
  <Footer />
</Base>

<style>
  /* Las secciones son ítems de grid: sin esto, un bloque de código o una tabla ancha las estira y la página
     desborda en el celular (los bloques ya tienen su propio scroll horizontal). */
  .docs :global(section),
  .docs :global(section > *) {
    min-width: 0;
  }
  .docs :global(h2) {
    scroll-margin-top: 96px;
  }
  .docs :global(h3) {
    margin-top: 0.75rem;
    color: var(--color-ink);
  }
  .docs :global(ul),
  .docs :global(ol) {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.2rem;
  }
  .docs :global(ul) {
    list-style: disc;
  }
  .docs :global(ol) {
    list-style: decimal;
  }
  /* Solo los links del texto: los botones (con clase) mantienen su estilo. */
  .docs :global(a:not([class])) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .docs :global(strong) {
    color: var(--color-ink);
  }
  .docs :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--color-ink);
  }
  /* Las URL largas en línea se cortan donde haga falta en vez de estirar la página. */
  .docs :global(:not(pre) > code) {
    overflow-wrap: anywhere;
  }
  .docs :global(pre code) {
    font-size: inherit;
  }
  .docs :global(.table-wrap) {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
  }
  .docs :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .docs :global(th),
  .docs :global(td) {
    padding: 0.55rem 0.8rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .docs :global(th) {
    background: var(--color-surface-2);
    color: var(--color-ink);
    font-weight: 600;
    white-space: nowrap;
  }
  .docs :global(tr:last-child td) {
    border-bottom: 0;
  }
</style>
