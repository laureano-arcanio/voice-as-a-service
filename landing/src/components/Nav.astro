---
import Button from "./Button.astro";
import Logo from "./Logo.astro";

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const hub = home ? "" : "/";
const links = [
  { href: `${hub}#como`, label: "Nuestro producto", short: "Producto" },
  { href: `${hub}#soluciones`, label: "Agentes", short: "Agentes" },
  { href: "#voces", label: "Voces", short: "Voces" },
  { href: "#precios", label: "Precios", short: "Precios" },
  { href: `${hub}#desarrolladores`, label: "Desarrolladores", short: "API" },
  { href: "#demo", label: "Contactanos", short: "Contacto" },
];
---

<nav class="sticky top-[env(safe-area-inset-top,0px)] z-10 border-b border-line bg-white/86 backdrop-blur-[10px]">
  <div class="mx-auto flex max-w-[1120px] items-center justify-between gap-4 px-5 py-3.5">
    <Logo href={home ? "#" : "/"} />
    <div class="flex items-center gap-6 text-[.98rem] font-medium max-[900px]:gap-4">
      {
        links.map((l) => (
          <a class="whitespace-nowrap text-ink-2 no-underline hover:text-ink max-[720px]:hidden" href={l.href}>
            <span class="max-[980px]:hidden">{l.label}</span>
            <span class="min-[981px]:hidden">{l.short}</span>
          </a>
        ))
      }
      <Button href="#llamada" size="sm" class="whitespace-nowrap" data-demo-link>Hacé una demo</Button>
    </div>
  </div>
  <!-- Mobile: los links en una segunda fila con rótulos cortos. Los 5 entran desde ~420 px; más angosto,
  la fila se desliza y el borde derecho se desvanece para que se note. -->
  <div class="flex gap-2 overflow-x-auto px-5 pb-3 max-[440px]:gap-1.5 max-[440px]:px-4 max-[420px]:mask-r-from-85% [scrollbar-width:none] min-[721px]:hidden [&::-webkit-scrollbar]:hidden">
    {
      links.map((l) => (
        <a
          class="flex-auto rounded-full border border-line-2 bg-white px-3 py-1.5 text-center text-[.92rem] max-[440px]:px-2.5 max-[440px]:text-[.85rem] font-semibold whitespace-nowrap text-ink no-underline active:border-accent active:text-accent"
          href={l.href}
        >
          {l.short}
        </a>
      ))
    }
  </div>
</nav>

<script>
  import { goToDemo } from "../scripts/demo-link";

  document.querySelectorAll<HTMLAnchorElement>("[data-demo-link]").forEach((a) => a.addEventListener("click", goToDemo));
</script>
