---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
import { industries } from "../data/industries";
import { verticals } from "../data/site";

interface Props {
  /** Donde estamos: define que links son del mismo documento y cual queda marcado. home: `/`. dev: `/desarrolladores`. docs: su documentacion. casos: `/casos-de-uso`. sector: una vertical. platform: `/plataforma` y sus capacidades. other: legales. */
  current?: "home" | "dev" | "docs" | "casos" | "sector" | "platform" | "other";
}

const { current = "other" } = Astro.props;
// Las anclas que existen en cada pagina; el resto va a la home.
const local: Record<NonNullable<Props["current"]>, string[]> = {
  home: ["voces", "precios", "demo"],
  dev: ["precios", "demo"],
  docs: ["demo"],
  casos: ["precios", "demo"],
  sector: ["voces", "precios", "demo"],
  platform: ["precios", "demo"],
  other: [],
};
const anchor = (id: string) => (local[current].includes(id) ? `#${id}` : `/#${id}`);
// Las paginas con widget de llamada (id="llamada") ofrecen "Hacé una demo"; el resto, el formulario.
const hasCall = current === "home" || current === "casos" || current === "sector";
const links = [
  { href: "/desarrolladores", label: "Desarrolladores", short: "Desarrolladores", active: current === "dev" },
  { href: "/casos-de-uso", label: "Casos de uso", short: "Casos", active: current === "casos" || current === "sector", menu: true },
  { href: anchor("voces"), label: "Voces", short: "Voces" },
  { href: anchor("precios"), label: "Precios", short: "Precios" },
  { href: "/desarrolladores/docs", label: "Docs", short: "Docs", active: current === "docs" },
  { href: anchor("demo"), label: "Contacto", short: "Contacto" },
];
const cta = current === "docs" || current === "dev" ? "Empezar gratis" : hasCall ? "Hacé una demo" : "Empezar gratis";
// Sin widget de llamada, el botón lleva al registro (docs/features/COBROS.md).
const ctaHref = hasCall ? "#llamada" : "/registro";
---

<nav class="sticky top-[env(safe-area-inset-top,0px)] z-10 border-b border-line bg-white/86 backdrop-blur-[10px]">
  <div class="mx-auto flex max-w-[1120px] items-center justify-between gap-4 px-5 py-3.5">
    <Logo href="/" />
    <div class="flex items-center gap-6 text-[.98rem] font-medium max-[1000px]:gap-4">
      {
        links.map((l) => {
          const link = (
            <a
              class:list={["whitespace-nowrap no-underline hover:text-ink max-[900px]:hidden", l.active ? "text-ink" : "text-ink-2"]}
              href={l.href}
              aria-current={l.active ? "page" : undefined}
            >
              {l.label}
            </a>
          );
          if (!l.menu) return link;
          // "Casos de uso" sigue siendo un link; con el mouse encima (o el foco adentro) despliega las industrias.
          return (
            <div class="group/menu relative max-[900px]:hidden">
              {link}
              <div class="invisible absolute top-full left-1/2 -translate-x-1/2 pt-4 opacity-0 transition-[opacity,visibility] duration-150 group-focus-within/menu:visible group-focus-within/menu:opacity-100 group-hover/menu:visible group-hover/menu:opacity-100 motion-reduce:transition-none">
                <div class="grid w-[560px] grid-cols-[1.3fr_1fr] gap-6 rounded-2xl border border-line bg-surface p-5 shadow-card">
                  <div class="grid content-start gap-1">
                    <p class="mb-1 font-mono text-[.72rem] tracking-[.06em] text-muted uppercase">Por industria</p>
                    {industries.filter((i) => i.group === "industria").map((i) => (
                      <a class="grid rounded-lg px-2.5 py-1.5 no-underline hover:bg-surface-2" href={`/casos-de-uso/${i.slug}`}>
                        <span class="text-[.95rem] font-semibold text-ink">{i.name}</span>
                        <span class="text-[.8rem] font-normal text-muted">{i.short}</span>
                      </a>
                    ))}
                  </div>
                  <div class="grid content-start gap-1">
                    <p class="mb-1 font-mono text-[.72rem] tracking-[.06em] text-muted uppercase">Por necesidad</p>
                    {verticals.map((v) => (
                      <a class="rounded-lg px-2.5 py-1.5 text-[.95rem] font-semibold text-ink no-underline hover:bg-surface-2" href={`/casos-de-uso/${v.slug}`}>
                        {v.title}
                      </a>
                    ))}
                    <p class="mt-3 mb-1 font-mono text-[.72rem] tracking-[.06em] text-muted uppercase">Otros usos</p>
                    {industries.filter((i) => i.group === "uso").map((i) => (
                      <a class="rounded-lg px-2.5 py-1.5 text-[.95rem] font-semibold text-ink no-underline hover:bg-surface-2" href={`/casos-de-uso/${i.slug}`}>
                        {i.name}
                      </a>
                    ))}
                    <a class="mt-2 px-2.5 text-[.9rem] font-semibold text-accent no-underline hover:text-accent-2" href="/casos-de-uso">
                      Ver todos los casos →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
      <Button href={ctaHref} size="sm" class="whitespace-nowrap" data-demo-link={hasCall ? "" : undefined}>
        {cta}
      </Button>
    </div>
  </div>
  <!-- Mobile: los links en una segunda fila con rótulos cortos. Hasta 900 px los links van en esta fila (no entran en la de arriba). Entran todos desde ~740 px; más angosto,
  la fila se desliza y el borde derecho se desvanece para que se note. -->
  <div class="flex gap-2 overflow-x-auto px-5 pb-3 max-[440px]:gap-1.5 max-[440px]:px-4 max-[740px]:mask-r-from-85% [scrollbar-width:none] min-[901px]:hidden [&::-webkit-scrollbar]:hidden">
    {
      links.map((l) => (
        <a
          class="flex-auto rounded-full border border-line-2 bg-white px-3 py-1.5 text-center text-[.92rem] max-[440px]:px-2.5 max-[440px]:text-[.85rem] font-semibold whitespace-nowrap text-ink no-underline active:border-accent active:text-accent"
          href={l.href}
        >
          {l.short}
        </a>
      ))
    }
  </div>
</nav>

<script>
  import { goToDemo } from "../scripts/demo-link";

  document.querySelectorAll<HTMLAnchorElement>("[data-demo-link]").forEach((a) => a.addEventListener("click", goToDemo));
</script>
