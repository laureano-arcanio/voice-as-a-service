---
// Home: los tres canales con íconos propios (ilustraciones SVG, no de una librería) y casi sin texto, para que se vea
// de un vistazo que el agente atiende WhatsApp, teléfono y la web. Al pasar el mouse, las ondas se mueven (sin movimiento
// con prefers-reduced-motion).
import { channels } from "../data/channels";
import Section from "./Section.astro";

const phone =
  "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z";
const bars = [8, 14, 20, 12, 18, 9, 15, 11];
---

<Section id="canales" class="border-y border-line bg-bg-2">
  <div class="grid items-end gap-4 min-[801px]:grid-cols-[1fr_auto]">
    <div>
      <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">Canales</span>
      <h2 class="mt-3">Atiende donde te buscan</h2>
    </div>
    <a class="font-semibold text-accent no-underline hover:text-accent-2" href="/canales">Ver los canales →</a>
  </div>

  <div class="mt-9 grid gap-4 min-[641px]:grid-cols-3">
    {
      channels.map((c) => (
        <a
          class="ch-card group/ch grid justify-items-center gap-4 rounded-3xl border border-line bg-surface px-6 pt-8 pb-7 text-center no-underline transition-[border-color,translate,box-shadow] duration-200 hover:-translate-y-1 hover:border-line-2 hover:shadow-card"
          href={`/canales/${c.slug}`}
        >
          <svg class="size-[120px] drop-shadow-[0_14px_22px_rgba(11,18,32,.14)]" viewBox="0 0 120 120" aria-hidden="true">
            {c.icon === "whatsapp" && (
              <>
                <defs>
                  <linearGradient id="ch-wa" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#3ee58a" />
                    <stop offset="1" stop-color="#0c9467" />
                  </linearGradient>
                </defs>
                <rect width="120" height="120" rx="34" fill="url(#ch-wa)" />
                <circle cx="34" cy="28" r="34" fill="#fff" opacity=".08" />
                <path d="M56 22a29 29 0 0 0-25 43.6L27 80l15-3.9A29 29 0 1 0 56 22z" fill="#fff" />
                <g transform="translate(43 37) scale(1.1)">
                  <path d={phone} fill="#12a46b" />
                </g>
                <g class="ch-note">
                  <rect x="58" y="70" width="48" height="26" rx="13" fill="#e7fbe0" stroke="#fff" stroke-width="3" />
                  <path d="M67 77.5v11l8.5-5.5z" fill="#0c9467" />
                  {bars.slice(0, 6).map((h, i) => (
                    <rect class="ch-bar" x={80 + i * 4} y={83 - h / 3} width="2.4" height={(h * 2) / 3} rx="1.2" fill="#0c9467" style={`animation-delay:${i * 0.09}s`} />
                  ))}
                </g>
              </>
            )}
            {c.icon === "phone" && (
              <>
                <defs>
                  <linearGradient id="ch-tel" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#5b86ff" />
                    <stop offset="1" stop-color="#1740b8" />
                  </linearGradient>
                </defs>
                <rect width="120" height="120" rx="34" fill="url(#ch-tel)" />
                <circle cx="34" cy="28" r="34" fill="#fff" opacity=".08" />
                <g transform="translate(24 30) scale(2.35)">
                  <path d={phone} fill="#fff" />
                </g>
                <path class="ch-arc" d="M74 28a17 17 0 0 1 14 14" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" />
                <path class="ch-arc ch-arc-2" d="M76 15a30 30 0 0 1 25 25" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".6" />
                <circle cx="91" cy="91" r="17" fill="#fff" />
                {[0, 1, 2].map((i) => (
                  <rect class="ch-bar" x={83 + i * 6} y={i === 1 ? 82 : 86} width="4" height={i === 1 ? 18 : 10} rx="2" fill="#2456e6" style={`animation-delay:${i * 0.12}s`} />
                ))}
              </>
            )}
            {c.icon === "web" && (
              <>
                <defs>
                  <linearGradient id="ch-web" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#9a7bff" />
                    <stop offset="1" stop-color="#4b2fd1" />
                  </linearGradient>
                </defs>
                <rect width="120" height="120" rx="34" fill="url(#ch-web)" />
                <circle cx="34" cy="28" r="34" fill="#fff" opacity=".08" />
                <rect x="18" y="26" width="84" height="64" rx="11" fill="#fff" />
                <path d="M18 41h84" stroke="#e4ddff" stroke-width="2" />
                {[27, 34, 41].map((x) => <circle cx={x} cy="33.5" r="2.6" fill="#c9bbff" />)}
                <rect x="50" y="31" width="44" height="5" rx="2.5" fill="#efeaff" />
                {bars.map((h, i) => (
                  <rect class="ch-bar" x={i < 4 ? 30 + i * 5 : 72 + (i - 4) * 5} y={66 - h / 2.4} width="2.6" height={h / 1.2} rx="1.3" fill="#8b6cff" style={`animation-delay:${i * 0.08}s`} />
                ))}
                <circle cx="60" cy="66" r="13" fill="#4b2fd1" />
                <g transform="translate(52.5 58.5) scale(.62)">
                  <path d={phone} fill="#fff" />
                </g>
                <path d="M80 78l0 22 6-6 4.5 9 4-2-4.5-9 8.5-.5z" fill="#fff" stroke="#1f1640" stroke-width="2.4" stroke-linejoin="round" />
              </>
            )}
          </svg>
          <span class="grid gap-1">
            <span class="font-display text-[1.3rem] font-extrabold tracking-[-0.01em] text-ink">{c.name}</span>
            <span class="text-[.94rem] text-muted">{c.short}</span>
          </span>
        </a>
      ))
    }
  </div>

</Section>

<style>
  .ch-bar,
  .ch-arc {
    transform-box: fill-box;
  }
  .ch-bar {
    transform-origin: center;
  }
  .ch-arc {
    transform-origin: bottom left;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ch-card:hover .ch-bar,
    .ch-card:focus-visible .ch-bar {
      animation: ch-bar 0.6s ease-in-out infinite alternate;
    }
    .ch-card:hover .ch-arc,
    .ch-card:focus-visible .ch-arc {
      animation: ch-arc 0.9s ease-in-out infinite;
    }
    .ch-card:hover .ch-arc-2,
    .ch-card:focus-visible .ch-arc-2 {
      animation-delay: 0.2s;
    }
  }
  @keyframes ch-bar {
    to {
      transform: scaleY(0.4);
    }
  }
  @keyframes ch-arc {
    50% {
      opacity: 0.2;
      transform: scale(1.08);
    }
  }
</style>
