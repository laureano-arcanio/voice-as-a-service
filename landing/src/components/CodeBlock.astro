---
interface Props {
  code: string;
  /** Rótulo sobre el bloque: "curl", "Python"... */
  label?: string;
}

const { code, label } = Astro.props;
---

<figure class="m-0 overflow-hidden rounded-xl border border-line bg-surface-2">
  {label && <figcaption class="border-b border-line px-4 py-1.5 font-mono text-[.72rem] tracking-[.06em] text-muted uppercase">{label}</figcaption>}
  <pre class="m-0 overflow-x-auto px-4 py-3 font-mono text-[.78rem]/[1.6] text-ink"><code>{code}</code></pre>
</figure>
