---
import { apiFeatures } from "../data/site";
import Button from "./Button.astro";
import CheckList from "./CheckList.astro";
import CodeTabs from "./CodeTabs.astro";
import Section from "./Section.astro";
---

<Section id="api" class="border-y border-line bg-bg-2">
  <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">API</span>
  <h2 class="mt-3">Una API compatible con OpenAI</h2>
  <p class="mt-3 max-w-[62ch] text-[1.12rem] text-ink-2">
    Cambiás la <code class="font-mono text-[.9em]">base_url</code> y usás el SDK que ya tenés. Una API key por sistema, con el alcance que elijas, y el consumo del mes contra tu plan a un pedido de distancia.
  </p>

  <div class="mt-9 grid items-start gap-7 min-[901px]:grid-cols-2 min-[901px]:gap-12">
    <div class="grid gap-6">
      <CheckList items={apiFeatures} />
      <div>
        <Button href="/desarrolladores/docs" variant="ghost">Leer la documentación</Button>
      </div>
    </div>
    <CodeTabs />
  </div>
</Section>
