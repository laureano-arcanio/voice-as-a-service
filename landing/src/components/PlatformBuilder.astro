---
// Home, debajo de "Un servicio en lugar de seis proveedores": la plataforma para armar agentes con funciones avanzadas,
// con el video del panel (mudo y en loop) al lado.
import type { Feature } from "../data/site";
import AutoVideo from "./AutoVideo.astro";
import Button from "./Button.astro";
import CheckList from "./CheckList.astro";
import Section from "./Section.astro";

const features: Feature[] = [
  { title: "Herramientas", text: "El agente consulta y registra en tu sistema mientras habla: turnos, pedidos, saldos o reclamos." },
  { title: "Transferencia a tu equipo", text: "Le pasa la llamada a una persona, en orden o por rotación, con horarios y música de espera.", href: "/canales/llamadas-telefonicas", link: "Ver cómo deriva" },
  { title: "Campañas salientes", text: "Llama o escribe por WhatsApp a tu lista, con horarios y reintentos." },
  { title: "Versiones y pruebas", text: "Cada cambio queda como una versión, y lo probás hablándole desde el panel." },
  { title: "Datos de cada conversación", text: "Transcripción, resultado y datos tomados, en el panel o en tu sistema por API o webhook." },
  { title: "Reportes", text: "Cuántas consultas recibís, cuántas terminan bien y cuántas pasan a una persona." },
];
---

<Section id="panel">
  <div class="grid items-center gap-9 min-[901px]:grid-cols-[1.15fr_1fr] min-[901px]:gap-12">
    <div class="grid gap-5">
      <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">La plataforma</span>
      <h2>Todo para crear tus agentes, en un solo panel</h2>
      <p class="max-w-[62ch] text-[1.12rem] text-ink-2">
        Elegís la voz, le das la información de tu negocio y lo conectás a tu sistema. Además de atender, el agente resuelve, deriva y llama.
      </p>
      <CheckList items={features} />
      <div class="flex flex-wrap gap-3">
        <Button href="/registro">Empezar gratis</Button>
        <Button href="/casos-de-uso" variant="ghost">Ver casos de uso</Button>
      </div>
    </div>
    <AutoVideo src="landing-panel-v5" title="El panel de Atentina: así se configura un agente" sound={false} aspect="4/5" frame={false} />
  </div>
</Section>
