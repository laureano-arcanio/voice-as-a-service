---
import { agenticFeatures, skillTools } from "../data/site";
import AgentTerminal from "./AgentTerminal.astro";
import Button from "./Button.astro";
import CheckList from "./CheckList.astro";
import Section from "./Section.astro";
---

<Section id="agentes">
  <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">Integración agéntica</span>
  <h2 class="mt-3">De un CSV a 240 llamadas, en una sola frase</h2>
  <p class="mt-3 max-w-[62ch] text-[1.12rem] text-ink-2">
    Tu agente de programación opera la plataforma por la API: crea el agente, lanza las llamadas, descarga los resultados y arma el informe. Pedile en español lo que necesitás: tenemos skills para los agentes de programación más usados, para que no tengas que explicarle cómo funciona.
  </p>

  <div class="mt-9 grid items-start gap-7 min-[901px]:grid-cols-[.9fr_1.1fr] min-[901px]:gap-12">
    <div class="grid gap-6">
      <div class="grid gap-2.5">
        <span class="font-mono text-[.76rem] tracking-[.06em] text-muted uppercase">Skills para</span>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {
            skillTools.map((tool) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-line-2 bg-surface px-3.5 py-1.5 text-[.95rem] font-semibold">
                <span class="size-1.5 rounded-full bg-ok" aria-hidden="true" />
                {tool}
              </li>
            ))
          }
        </ul>
      </div>
      <CheckList items={agenticFeatures} />
      <div>
        <Button href="#demo">Empezar gratis</Button>
      </div>
    </div>
    <AgentTerminal />
  </div>
</Section>
