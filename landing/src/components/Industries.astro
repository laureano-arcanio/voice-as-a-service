---
// Tarjetas de los canales, las páginas por industria y otros usos (src/data/channels.ts y industries.ts).
import { channels } from "../data/channels";
import { industries } from "../data/industries";
import Icon from "./Icon.astro";
import Section from "./Section.astro";

type Card = { href: string; name: string; short: string; icon?: (typeof channels)[number]["icon"] };
const toCard = (i: (typeof industries)[number]): Card => ({ href: `/casos-de-uso/${i.slug}`, name: i.name, short: i.short });

const groups: { id: string; title: string; lead: string; items: Card[] }[] = [
  {
    id: "canales",
    title: "Por canal",
    lead: "El mismo agente atiende por WhatsApp, por teléfono y desde tu web.",
    items: channels.map((c) => ({ href: `/canales/${c.slug}`, name: c.name, short: c.short, icon: c.icon })),
  },
  { id: "industrias", title: "Por industria", lead: "Qué hace el agente en cada rubro, con un ejemplo de llamada.", items: industries.filter((i) => i.group === "industria").map(toCard) },
  { id: "otros-usos", title: "Otros usos", lead: "Traducción, voces y transcripción, con la misma plataforma.", items: industries.filter((i) => i.group === "uso").map(toCard) },
];
---

<Section id="industrias">
  {
    groups.map((g, n) => (
      <div id={n > 0 ? g.id : undefined} class:list={[n > 0 && "mt-14"]}>
        <h2>{g.title}</h2>
        <p class="mt-3 max-w-[62ch] text-[1.12rem] text-ink-2">{g.lead}</p>
        <div class="mt-9 grid gap-3 min-[561px]:grid-cols-2 min-[901px]:grid-cols-4">
          {g.items.map((i) => (
            <a
              class="grid content-start gap-1 rounded-2xl border border-line bg-surface p-5 no-underline transition-[border-color,translate,box-shadow] duration-150 hover:-translate-y-0.5 hover:border-accent hover:shadow-card"
              href={i.href}
            >
              <h3 class="flex items-center gap-2 text-[1.15rem]">
                {i.icon && <Icon name={i.icon} class="size-[18px] text-muted" />}
                {i.name}
              </h3>
              <p class="text-[.92rem] text-ink-2">{i.short}</p>
              <span class="mt-2 text-[.92rem] font-semibold text-accent">Ver cómo funciona →</span>
            </a>
          ))}
        </div>
      </div>
    ))
  }
</Section>
