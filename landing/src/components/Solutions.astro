---
import { verticals } from "../data/site";
import Section from "./Section.astro";

interface Props {
  exclude?: string;
  title?: string;
  /** Suma "¿Tu caso es otro?" debajo de las tarjetas. */
  other?: boolean;
}

const { exclude, title = "Un agente por necesidad, listo para usar.", other = false } = Astro.props;
const list = verticals.filter((v) => v.slug !== exclude);
---

<Section id="soluciones" class="border-y border-line bg-bg-2">
  <h2>{title}</h2>
  <div class:list={["mt-9 grid gap-4", list.length === 3 ? "min-[801px]:grid-cols-3" : "min-[801px]:grid-cols-2"]}>
    {
      list.map((v) => (
        <a
          class="grid content-start gap-3 rounded-2xl border border-line bg-surface p-6 no-underline transition-[border-color,translate,box-shadow] duration-150 hover:-translate-y-0.5 hover:border-accent hover:shadow-card"
          href={`/casos-de-uso/${v.slug}`}
          data-theme={v.slug}
        >
          <span class="font-mono text-[.76rem] tracking-[.04em] text-muted uppercase">{v.who}</span>
          <h3 class="text-[1.25rem]">{v.title}</h3>
          <p class="text-[.96rem] text-ink-2">{v.summary}</p>
          <span class="mt-auto text-[.95rem] font-semibold text-accent">Ver cómo funciona →</span>
        </a>
      ))
    }
  </div>
  {
    other && (
      <p class="mt-6 text-[1.02rem] text-ink-2">
        ¿Tu caso es otro? <a class="font-semibold text-accent no-underline hover:text-accent-2" href="#demo">Contanos qué necesitás atender →</a>
      </p>
    )
  }
</Section>
