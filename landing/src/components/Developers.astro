---
import { roadmap } from "../data/site";
import Button from "./Button.astro";
import Section from "./Section.astro";
import Status from "./Status.astro";
---

<Section id="desarrolladores" class="border-t border-line">
  <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">Lo que viene</span>
  <h2 class="mt-3">Estamos construyendo con integradores</h2>
  <p class="mt-3 max-w-[62ch] text-[1.12rem] text-ink-2">
    Esto todavía no está disponible. Si te sirve, contanos y lo priorizamos con vos.
  </p>

  <div class="mt-9 grid gap-4 min-[701px]:grid-cols-2 min-[1001px]:grid-cols-3">
    {
      roadmap.map((item) => (
        <div class="grid content-start gap-3 rounded-2xl border border-line bg-surface p-6">
          <Status status={item.status} />
          <h3 class="text-[1.2rem]">{item.title}</h3>
          <p class="text-[.96rem] text-ink-2">{item.text}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2">
    <Button href="#demo" variant="ghost">Pedir acceso anticipado</Button>
    <p class="text-[.95rem] text-muted">Contanos qué querés construir y te avisamos cuando esté.</p>
  </div>
</Section>
