---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="inline-flex items-center gap-2.5 font-display text-[1.35rem] font-extrabold tracking-[-0.02em] no-underline" href={href}>
  <svg class="size-[26px] flex-none" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true">
    <path d="M55.07 38.62A24 24 0 1 1 55.07 25.38" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round"></path>
    <rect x="20" y="26" width="6" height="12" rx="3" fill="var(--color-accent)"></rect>
    <rect x="29" y="21" width="6" height="22" rx="3" fill="var(--color-accent)"></rect>
    <rect x="38" y="26" width="6" height="12" rx="3" fill="var(--color-accent)"></rect>
  </svg>Atentina
</a>
