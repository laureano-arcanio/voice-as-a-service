---
// Home, debajo de "Una plataforma, tres capas": la plataforma también se usa desde el asistente de IA que ya tenés
// (Claude Code, Codex, ChatGPT, Cursor) por MCP, en palabras simples. Al lado, la terminal animada de desarrolladores.
import AgentTerminal from "./AgentTerminal.astro";
import Button from "./Button.astro";
import Section from "./Section.astro";

const asks = [
  "Creá un agente que dé turnos para la clínica, con la voz de Sofía.",
  "Mañana a las 10 llamá a los clientes con la cuota vencida.",
  "¿Cuántas consultas terminaron bien esta semana?",
];
---

<Section id="tu-asistente" class="border-t border-line bg-bg-2">
  <div class="grid items-center gap-9 min-[901px]:grid-cols-[1fr_1.1fr] min-[901px]:gap-12">
    <div class="grid gap-5">
      <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent uppercase">Tu asistente de IA</span>
      <h2>También lo maneja el asistente de IA que ya usás</h2>
      <p class="max-w-[62ch] text-[1.12rem] text-ink-2">
        Si trabajás con Claude Code, Codex, ChatGPT o Cursor, conectalo a Atentina y pedile en tus palabras lo que necesitás. Crea y prueba agentes, lanza llamadas y te arma los informes, con tu usuario y todo a la vista en tu panel.
      </p>
      <ul class="m-0 grid list-none gap-2 p-0">
        {
          asks.map((a) => (
            <li class="rounded-xl border border-line bg-surface px-4 py-2.5 text-[.98rem] text-ink-2 italic">«{a}»</li>
          ))
        }
      </ul>
      <div class="flex flex-wrap gap-3">
        <Button href="/desarrolladores/docs/mcp">Conectar tu asistente</Button>
        <Button href="/desarrolladores" variant="ghost">Para desarrolladores</Button>
      </div>
    </div>
    <AgentTerminal />
  </div>
</Section>
