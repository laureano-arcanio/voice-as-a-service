---
import { freePlan, plans } from "../data/site";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Section from "./Section.astro";

interface Props {
  /** Suma el plan Free (API y panel web, sin telefonía) como primera tarjeta. */
  free?: boolean;
  class?: string;
}

const { free = false, class: className } = Astro.props;
const list = free ? [freePlan, ...plans] : plans;
// Sin la tarjeta Free no se la nombra: los planes con telefonía no dicen "Todo lo que ofrece Free".
const itemsOf = (items: string[]) => (free ? items : items.filter((item) => !item.startsWith("Todo lo que ofrece Free")));
// En mobile las tarjetas van más cortas: sin lo que repite la escalera.
const secondary = (item: string) => /^Todo lo que ofrece/.test(item);
const label = "border-b border-line pb-2 font-mono text-[.76rem] tracking-[.06em] text-muted uppercase";
// Los planes con precio van al registro (con el plan, para abrirlo en el panel al activar la cuenta); "A medida", al contacto.
const signupHref = (plan: (typeof list)[number]) =>
  plan.signup === false ? "#demo" : plan.name === freePlan.name ? "/registro" : `/registro?plan=${encodeURIComponent(plan.name)}`;
const columns = { 3: "min-[1001px]:grid-cols-3", 4: "min-[1001px]:grid-cols-4" }[list.length] ?? "min-[1001px]:grid-cols-4";
---

<Section id="precios" class={className}>
  <h2>Un precio por mes, en pesos</h2>
  <p class="mt-3 max-w-[62ch] text-[1.12rem] text-ink-2">
    {
      free
        ? "Empezá gratis con la plataforma y la API. Cuando necesites telefonía, pasás a un plan con números, minutos y llamadas a la vez."
        : ""
    }{" "}
    Cada plan con telefonía incluye sus números, una cantidad de minutos por mes (entre las llamadas que entran y las que hace el agente) y cuántas llamadas atiende a la vez. Si necesitás más minutos, pasás al plan siguiente.
  </p>

  <div class:list={["mt-9 grid gap-4 min-[561px]:grid-cols-2", columns]}>
    {free && <p class:list={[label, "col-span-full min-[1001px]:order-1 min-[1001px]:col-span-1"]}>Para probar e integrar</p>}
    {
      list.map((plan, i) => (
        <>
        {free && i === 1 && <p class:list={[label, "col-span-full mt-4 min-[1001px]:order-2 min-[1001px]:col-span-3 min-[1001px]:mt-0"]}>Con telefonía incluida</p>}
        <div
          class:list={[
            "relative grid gap-3 rounded-[18px] border-[1.5px] bg-surface p-5 min-[561px]:grid-rows-[auto_auto_auto_auto_1fr_auto] min-[561px]:gap-[18px] min-[561px]:px-[22px] min-[561px]:py-[26px]",
            plan.featured ? "border-accent shadow-card" : "border-line",
            free && (i === 0 ? "min-[561px]:max-[1000px]:col-span-2 min-[1001px]:order-3" : "min-[1001px]:order-4"),
          ]}
        >
          {plan.featured && (
            <span class="absolute -top-3 left-[22px] rounded-full bg-accent px-2.5 py-1 font-mono text-[.72rem] tracking-[.06em] text-accent-ink uppercase">
              El más elegido
            </span>
          )}
          <h3 class="text-[1.4rem]">{plan.name}</h3>
          <p class="text-[.92rem] text-muted min-[561px]:min-h-[3.1em]">{plan.for}</p>
          <div class="flex flex-wrap items-baseline gap-1.5">
            <span class="font-display text-[2rem] font-extrabold tracking-[-0.02em] whitespace-nowrap tabular-nums">{plan.price}</span>
            {plan.per && <span class="text-[.9rem] text-muted">{plan.per}</span>}
          </div>
          <p class="-mt-3 text-[.85rem] text-muted tabular-nums max-[560px]:mt-0">{plan.usd}</p>
          <ul class="m-0 grid list-none content-start gap-[9px] p-0 text-[.95rem] [&_b]:font-semibold">
            {itemsOf(plan.items).map((item) => (
              <li class:list={["flex items-start gap-[9px]", secondary(item) && "max-[560px]:hidden"]}>
                <span class="mt-0.5 grid size-[18px] flex-none place-items-center rounded-full bg-ok-soft text-ok">
                  <Icon name="check" class="size-3.5 stroke-[2.2]" />
                </span>
                <span set:html={item} />
              </li>
            ))}
          </ul>
          <Button href={signupHref(plan)} variant={plan.featured ? "primary" : "ghost"} class="mt-auto self-end">
            {plan.cta}
          </Button>
        </div>
        </>
      ))
    }
  </div>

  {
    free && (
      <p class="mt-6 text-[1.02rem] text-ink-2">
        ¿Necesitás más volumen de la API? <a class="font-semibold text-accent no-underline hover:text-accent-2" href="#demo">Escribinos y lo armamos a medida →</a>
      </p>
    )
  }

  <div class="mt-[22px] grid max-w-[78ch] gap-1.5 text-[.9rem] text-muted">
    <p>Precio final por mes, en pesos. Sin permanencia: se cancela cuando quieras.</p>
    <p class="tabular-nums">
      Los minutos del plan son por mes y no se acumulan. Si el precio cambia, avisamos con 15 días de anticipación. Cada llamada se cuenta por minuto iniciado.
    </p>
  </div>
</Section>
