---
import { contactEmail } from "../data/site";
import Button from "./Button.astro";

interface Props {
  subject?: string;
}

const { subject = "Quiero una demo de Atentina" } = Astro.props;
const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}`;
---

<section class="bg-ink py-[76px] text-center text-cta-ink" id="demo">
  <div class="mx-auto grid max-w-[1120px] justify-items-center gap-5 px-5">
    <span class="font-mono text-[.78rem] font-medium tracking-[.08em] text-accent-on-dark uppercase">Demo</span>
    <h2>Escuchá un agente con tu propio caso</h2>
    <p class="max-w-[62ch] text-[1.12rem] text-cta-muted">
      Nos contás a qué se dedica tu empresa y armamos un agente para que lo escuches con tus datos. Sin costo y sin compromiso.
    </p>
    <Button href={mailto} variant="light">Pedir una demo</Button>
    <p class="text-[1.05rem] text-cta-ink tabular-nums select-all"><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
  </div>
</section>
