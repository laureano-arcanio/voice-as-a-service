---
// Una versión de las condiciones o de la política de privacidad (data/legal.ts). La vigente va en /<slug>; cada
// versión, también la vigente, en /<slug>/<versión> (link permanente: es lo que se acepta en el registro).
import { type LegalSlug, legal, legalContent, versionDate } from "../data/legal";
import Legal from "./Legal.astro";

interface Props {
  slug: LegalSlug;
  version?: string;
  description: string;
}

const { slug, description } = Astro.props;
const doc = legal[slug];
const version = Astro.props.version ?? doc.current;
const current = version === doc.current;
const sha256 = doc.versions.find((v) => v.version === version)!.sha256;
const Content = legalContent(slug, version);
const others = [...doc.versions].reverse();
---

<Legal
  title={doc.title}
  description={description}
  path={Astro.props.version ? `/${slug}/${version}` : `/${slug}`}
  updated={`${versionDate(version)} · versión ${version}`}
>
  {
    !current && (
      <p class="rounded-xl border border-line bg-bg-2 px-4 py-3">
        Esta es una versión anterior, que ya no rige. La vigente es la <a href={`/${slug}`}>del {versionDate(doc.current)}</a>.
      </p>
    )
  }
  <Content />
  <h2>Versiones</h2>
  <ul>
    {
      others.map((v) => (
        <li>
          <a href={`/${slug}/${v.version}`}>{versionDate(v.version)}</a>
          {v.version === doc.current ? " (vigente)" : ""}
        </li>
      ))
    }
  </ul>
  <p class="font-mono text-[.72rem] break-all text-muted">Huella SHA-256 de esta versión: {sha256}</p>
</Legal>
