# Base de datos MySQL
# NOTA: este DB_DSN apunta a 127.0.0.1 para el deploy bare-metal/systemd (ver
# README.md). Al correr con `docker compose` este valor se IGNORA para el
# contenedor `app` -- docker-compose.yml arma su propio DB_DSN a partir de las
# variables MYSQL_* de abajo y apunta al servicio `db` en vez de 127.0.0.1.
DB_DSN=mysql+pymysql://aiva_validate:PASSWORD@127.0.0.1/aiva_validate?charset=utf8mb4

# --- Proveedor de voz: LiveKit Agents + troncal SIP saliente ---
# URL/keys del proyecto de LiveKit Cloud (Project Settings -> Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ID de la troncal SIP saliente de LiveKit (ST_...) por la que marca el agente.
# Con Anura + Asterisk la crea `make livekit-sip` y la imprime (ver
# docs/TELEFONIA_ANURA.md); con Twilio, ver el runbook del README.
LIVEKIT_SIP_TRUNK_ID=
# Nombre de ruteo del agente para el dispatch explicito (debe matchear EXACTO
# entre el proceso `app` que dispara la llamada y el proceso `agent` que la
# atiende). OJO: no confundir con AGENT_NAME de abajo (ese es el nombre de
# fantasia que dice el agente al hablar, ej. "Sofia"; este es el identificador
# tecnico de ruteo de LiveKit).
LIVEKIT_AGENT_NAME=aiva-outbound-caller
# Duracion maxima de una llamada antes de cortarla forzosamente.
CALL_MAX_DURATION_SECONDS=900

# --- Inferencia local (vLLM) ---
# LLM conversacional + STT + TTS + scoring, servidos por los contenedores
# vllm-llm/vllm-stt/vllm-tts de docker-compose.yml contra la GPU local -- ya no
# se usan proveedores externos (OpenAI/ElevenLabs/Anthropic). Los 3 hablan API
# compatible con OpenAI (mismo openai SDK que ya usaba livekit-agents antes,
# cambiando solo base_url/api_key).
#
# Si app/agent corren en OTRA PC (`make up-remote`), apuntar las 3 *_BASE_URL
# mas abajo a las URLs de ngrok del host GPU
# (https://$NGROK_DOMAIN/{llm,stt,tts}/v1) -- ver "Inferencia remota" en README.
#
# Clave que los 3 servidores vLLM exigen como `Authorization: Bearer` en
# /v1/* (docker-compose.yml les pasa --api-key=${VLLM_API_KEY}) y que app/agent/
# scoring mandan al llamarlos. Para uso interno cualquier valor sirve;
# SI se exponen por ngrok (`make tunnel`) usar una clave larga y aleatoria:
# `openssl rand -hex 24`. ngrok no agrega auth propia: esta es la unica.
VLLM_API_KEY=not-needed

# LLM: Qwen3.5-4B. /v1/chat/completions y /v1/responses -- swap directo de
# openai.responses.LLM(...).
VLLM_LLM_BASE_URL=http://vllm-llm:8000/v1
VLLM_LLM_MODEL=Qwen/Qwen3.5-4B
# Scoring (evaluacion del transcript al colgar, ver app/scoring.py): comparte
# el LLM de arriba por defecto. Descomentar para usar un modelo distinto si
# alguna vez se agrega otro al stack.
#VLLM_SCORING_MODEL=Qwen/Qwen3.5-4B

# STT: Qwen3-ASR-1.7B. /v1/audio/transcriptions (REST por-turno, sin partials
# como gpt-live-transcribe -- ver comentario en docker-compose.yml).
VLLM_STT_BASE_URL=http://vllm-stt:8000/v1
VLLM_STT_MODEL=Qwen/Qwen3-ASR-1.7B
# STT candidatos (perfil `stt-eval`: `make stt-eval-up`, comparar con
# `make stt-eval`). Para probar uno en llamadas reales, cambiar
# VLLM_STT_BASE_URL y descomentar AGENT_STT_MODEL (NO tocar VLLM_STT_MODEL:
# compose lo usa para el comando de vllm-stt), y recrear el agente con
# `docker compose up -d agent` (`make restart` no relee .env):
#   Parakeet TDT 0.6B v3:   http://stt-parakeet:8000/v1  nvidia/parakeet-tdt-0.6b-v3
#   Whisper Large v3 Turbo: http://stt-whisper:8000/v1   openai/whisper-large-v3-turbo
#   Moonshine Spanish:      http://stt-moonshine:8000/v1 moonshine-es
#AGENT_STT_MODEL=nvidia/parakeet-tdt-0.6b-v3

# TTS: Qwen3-TTS-12Hz-1.7B-Base (checkpoint de voice-cloning), servido con
# vLLM-Omni. /v1/audio/speech (y /v1/audio/speech/stream) OpenAI-compatible --
# swap directo de elevenlabs.TTS(...) por openai.TTS(voice=..., ...).
#
# "sofia_ar" es una voz clonada (no un preset de fabrica): se subio UNA vez
# con audio real de una hablante argentina via POST /v1/audio/voices, ver
# comentario de vllm-tts en docker-compose.yml. Si esta variable no matchea
# ninguna voz subida (`GET /v1/audio/voices` contra vllm-tts para listarlas),
# la sintesis va a fallar -- hay que registrar la voz de nuevo con ese nombre.
VLLM_TTS_BASE_URL=http://vllm-tts:8000/v1
VLLM_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
VLLM_TTS_VOICE=sofia_ar
# OJO: probado que el server rechaza con 400 cualquier valor != 1.0 en modo
# streaming ("Streaming is not supported with speed adjustment") -- dejar en
# 1.0 salvo que se acepte perder streaming (mata la latencia de la llamada).
VLLM_TTS_SPEED=1.0

# Token de HuggingFace, solo si alguno de los 3 modelos de arriba requiere
# aceptar licencia/estar gateado (los de Qwen elegidos aca no lo requieren
# hoy). Se pasa a los 3 contenedores vllm-*.
HF_TOKEN=

# --- ngrok: exponer los 3 vllm-* a internet (opcional, `make tunnel`) --------
# No hace falta para el demo local: son solo para consumir LLM/STT/TTS desde
# afuera del host. `make up` no arranca estos contenedores (perfil `ngrok`).
# Auth: no la hace ngrok, la hace cada vLLM con VLLM_API_KEY de arriba --
# completar esa variable con una clave real antes de exponer nada.
#
# Authtoken de la cuenta (Dashboard ngrok -> Getting Started -> Your Authtoken).
NGROK_AUTHTOKEN=
# Dev domain asignado a la cuenta (Dashboard ngrok -> Domains), SIN esquema ni
# path: ej. algo-random.ngrok-free.dev. Es un unico tunel al root del domain
# (los agent endpoints no aceptan paths); el proxy nginx interno (ngrok/proxy.conf)
# rutea /llm, /stt y /tts a cada vLLM: https://$NGROK_DOMAIN/llm/v1, /stt/v1 y
# /tts/v1.
NGROK_DOMAIN=

# --- Telefonia: troncal Anura via Asterisk (opcional, `make pbx`) ------------
# PSTN <-> Anura <-> Asterisk (contenedor `asterisk`, perfil `pbx`) <-> LiveKit.
# Runbook completo (port forwarding del router incluido): docs/TELEFONIA_ANURA.md.
#
# Credenciales de una TERMINAL de la cuenta de Anura dueña del número (panel ->
# Cuentas -> la cuenta -> Terminales -> Obtener credenciales), no de una cuenta
# de "Troncales": ver docs/TELEFONIA_ANURA.md.
ANURA_DOMAIN=miempresa.grancentral.com.ar
ANURA_USER=
ANURA_PASSWORD=
# Numero de la troncal en formato nacional de 10 digitos: caracteristica +
# abonado, sin 0, sin 15 y sin +54 (ej. 1152630861). Es el caller ID de las
# salientes; en LiveKit queda como +54<ANURA_DID>.
ANURA_DID=
#
# SIP URI de LiveKit Cloud SIN "sip:" (Dashboard -> Settings -> Project ->
# SIP URI; es <project-id sin p_>.sip.livekit.cloud). OJO: no es LIVEKIT_URL.
LIVEKIT_SIP_HOST=
# Clave compartida Asterisk <-> LiveKit, usuario fijo "livekit". Va en los dos
# trunks de LiveKit (`make livekit-sip`) y en pjsip.conf. Generar con
# `openssl rand -hex 24` (solo hex: un `$` se interpola en docker-compose).
LIVEKIT_SIP_PASSWORD=
#
# IP publica (o hostname de DDNS) que Asterisk anuncia a Anura y a LiveKit.
# Vacio = se autodetecta al arrancar. Si la IP del ISP es dinamica conviene un
# DDNS: si cambia hay que reiniciar Asterisk y volver a correr `make livekit-sip`.
ASTERISK_PUBLIC_ADDRESS=
# Puertos que el router tiene que redirigir (UDP) a este host: SIP de LiveKit y
# el rango RTP. 5080 y no 5060 para esquivar el grueso de los escaneos
# automaticos de SIP en internet.
ASTERISK_SIP_PORT=5080
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10199
# Puerto SIP local para Anura. NO se redirige en el router: Anura entra por el
# agujero que abre el registro en el NAT.
ASTERISK_ANURA_SIP_PORT=5081

# --- Personalizacion del demo ---
AGENT_NAME=Sofia
COMPANY_NAME=Browix
# Nombre con el que el agente saluda en las llamadas ENTRANTES (no se conoce al que llama).
INBOUND_CALLER_NAME=Francisco

# --- Solo Docker Compose: credenciales del contenedor MySQL ---
# Se usan para configurar el servicio `db` y para armar el DB_DSN de arriba
# dentro del contenedor `app`. Mantener MYSQL_PASSWORD solo con
# alfanumericos/guion/guion_bajo -- se interpola directo en una URL de DSN y
# caracteres como @ / : # % la rompen.
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=aiva_validate
MYSQL_USER=aiva_validate
MYSQL_PASSWORD=changeme

# --- Solo Docker Compose: UID/GID de build para el usuario no-root del app ---
# Solo importa para el bind mount de storage/. Por defecto 1000:1000 si no se
# define (coincide con la mayoria de las maquinas Linux de un solo usuario).
# Descomentar y setear al resultado de `id -u`/`id -g` si difieren en tu
# maquina, para evitar errores de permisos en storage/recordings.
#UID=1000
#GID=1000
