# --- Proveedor de voz: LiveKit Agents + troncal SIP saliente ---
# URL/keys del proyecto de LiveKit Cloud (Project Settings -> Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ID de la troncal SIP saliente de LiveKit (ST_...) por la que marca el agente.
# Con Anura + Asterisk la crea `make livekit-sip` y la imprime (ver
# docs/TELEFONIA_ANURA.md). Vacio: el agente usa la que se llama
# "anura-asterisk-outbound". Con LiveKit propio dejarlo vacio: su Redis no
# persiste y el ID cambia en cada reinicio del host.
LIVEKIT_SIP_TRUNK_ID=
# Nombre de ruteo del agente para el dispatch explicito (debe matchear EXACTO
# entre el proceso `app` que dispara la llamada y el proceso `agent` que la
# atiende).
LIVEKIT_AGENT_NAME=aiva-outbound-caller
# LiveKit propio en este host (desarrollo), en lugar de Cloud: ver
# docker-compose.livekit.yml y docs/TELEFONIA_ANURA.md, seccion 7. Las LIVEKIT_*
# de arriba pasan a ser las del server propio (LIVEKIT_URL=ws://<IP LAN>:7880,
# claves nuevas, LIVEKIT_SIP_HOST=127.0.0.1:5060) y se agrega:
# COMPOSE_FILE=docker-compose.yml:docker-compose.livekit.yml
# LIVEKIT_LOCAL_NODE_IP=192.168.1.99      # IP de la LAN que anuncia el server
# LIVEKIT_NODE_IP=181.104.113.28          # IP publica: para la demo de la landing (docs/LANDING.md)
# Las de Cloud se guardan como LIVEKIT_CLOUD_URL/_API_KEY/_API_SECRET/
# _SIP_TRUNK_ID/_SIP_HOST para volver.
# Capacidad de la inferencia, una variable por motor (defaults = config
# vigente; se aplican con `make up-inference`, ver docker-compose.yml):
# VLLM_LLM_MAX_NUM_SEQS=128               # pedidos simultaneos del LLM (y CUDA graphs)
# VLLM_LLM_GPU_MEMORY_UTILIZATION=0.90
# STT_MAX_BATCH=8                         # batching dinamico de Parakeet
# STT_MAX_BATCH_SECONDS=120               # segundos de audio por batch
# VLLM_TTS_GPU_MEMORY_UTILIZATION=0.4
# VLLM_TTS_MAX_NUM_SEQS=128               # sintesis simultaneas por etapa
# Duracion maxima de una llamada antes de cortarla forzosamente.
CALL_MAX_DURATION_SECONDS=900

# --- Inferencia local ---
# LLM conversacional + STT + TTS, servidos por los contenedores
# vllm-llm/stt-parakeet/vllm-tts de docker-compose.yml contra la GPU local -- ya no
# se usan proveedores externos (OpenAI/ElevenLabs/Anthropic). Los 3 hablan API
# compatible con OpenAI (mismo openai SDK que ya usaba livekit-agents antes,
# cambiando solo base_url/api_key).
#
# Si app/agent corren en OTRA PC (`make up-agent`), apuntar las 3 *_BASE_URL
# mas abajo al proxy del host GPU
# (http://$PUBLIC_HOST:$PROXY_PORT/{llm,stt,tts}/v1) -- ver "Inferencia remota" en README.
#
# Clave que los 3 servidores de inferencia exigen como `Authorization: Bearer`
# en /v1/* (docker-compose.yml se la pasa) y que app/agent mandan al
# llamarlos. Para uso interno cualquier valor sirve;
# SI se exponen por el proxy (`make up`/`make up-nginx`) usar una clave larga y aleatoria:
# `openssl rand -hex 24`. El proxy no agrega auth propia: esta es la unica.
VLLM_API_KEY=not-needed

# LLM: Qwen3.5-9B en 4 bits (EXP-009). /v1/chat/completions con structured output (app/llm/client.py).
VLLM_LLM_BASE_URL=http://vllm-llm:8000/v1
VLLM_LLM_MODEL=RedHatAI/Qwen3.5-9B-quantized.w4a16
# Pensamiento del LLM en cada turno, con tope de tokens (ver app/config.py). Con 128:
# ~2,3 s por turno contra ~1,5 s sin pensar. Muestreo: el recomendado por Qwen para
# cada modo; LLM_TEMPERATURE lo pisa.
LLM_THINKING=false
LLM_THINKING_BUDGET=128
#LLM_TEMPERATURE=0.6

# STT: Parakeet TDT 0.6B v3 (stt-parakeet, stt/server.py). /v1/audio/transcriptions
# (REST por turno, sin parciales). Reemplazo a Qwen3-ASR-1.7B (EXP-007/008).
VLLM_STT_BASE_URL=http://stt-parakeet:8000/v1
VLLM_STT_MODEL=nvidia/parakeet-tdt-0.6b-v3

# TTS: Qwen3-TTS-12Hz-1.7B-Base con fine-tuning de 41 voces en un checkpoint (multi41 ep. 2,
# docs/TTS_FINETUNE.md), servido con vLLM-Omni. /v1/audio/speech con streaming, OpenAI-compatible.
# El checkpoint es custom_voice: la voz va por nombre (sofia, martin, ...), sin audio de referencia.
# Voces con genero y metricas: tts/finetune/voces.tsv. Cada workflow elige la suya (agent.voice);
# VLLM_TTS_VOICE es la de respaldo (workflow sin voz, o voz que vllm-tts no sirve).
# vllm-tts sirve el checkpoint de TTS_FT_CKPT con el nombre VLLM_TTS_MODEL.
# Para cambiar de checkpoint: las 3 variables y `make up-inference` + `make up-agent`.
VLLM_TTS_BASE_URL=http://vllm-tts:8000/v1
VLLM_TTS_MODEL=qwen3-tts-ft
VLLM_TTS_VOICE=sofia
#TTS_FT_CKPT=./tts/finetune/work/runs/multi41/lr2e-6/checkpoint-epoch-2

# Token de HuggingFace, solo si alguno de los modelos de arriba requiere
# aceptar licencia/estar gateado (hoy ninguno). Se pasa a los 3 contenedores
# de inferencia.
HF_TOKEN=

# --- Proxy publico: la inferencia expuesta a internet (`make up-nginx`) ---
# Para consumir LLM/STT/TTS desde afuera del host (ej. la PC del loadtest).
# `make up` lo levanta. Es HTTP plano en la IP fija, sin TLS; la auth la hace cada
# vLLM con VLLM_API_KEY de arriba -- completarla con una clave real antes de
# exponer nada. El router tiene que redirigir PROXY_PORT (TCP) a este host.
#
# IP fija (o dominio) por la que se llega a este host desde afuera, sin
# esquema ni puerto. Solo arma las URLs que imprime `make up-nginx`.
PUBLIC_HOST=
# Puerto del host donde escucha el proxy nginx (proxy/nginx.conf), que rutea
# /llm, /stt y /tts a cada vLLM: http://$PUBLIC_HOST:$PROXY_PORT/llm/v1, etc.
PROXY_PORT=8100

# --- Telefonia: troncal Anura via Asterisk (opcional, `make pbx`) ------------
# PSTN <-> Anura <-> Asterisk (contenedor `asterisk`, perfil `pbx`) <-> LiveKit.
# Runbook completo (port forwarding del router incluido): docs/TELEFONIA_ANURA.md.
#
# Credenciales de una TERMINAL de la cuenta de Anura dueña del número (panel ->
# Cuentas -> la cuenta -> Terminales -> Obtener credenciales), no de una cuenta
# de "Troncales": ver docs/TELEFONIA_ANURA.md.
ANURA_DOMAIN=miempresa.grancentral.com.ar
ANURA_USER=
ANURA_PASSWORD=
# Numero de la troncal en formato nacional de 10 digitos: caracteristica +
# abonado, sin 0, sin 15 y sin +54 (ej. 1152630861). Es el caller ID de las
# salientes; en LiveKit queda como +54<ANURA_DID>.
ANURA_DID=
#
# SIP URI de LiveKit Cloud SIN "sip:" (Dashboard -> Settings -> Project ->
# SIP URI; es <project-id sin p_>.sip.livekit.cloud). OJO: no es LIVEKIT_URL.
LIVEKIT_SIP_HOST=
# Clave compartida Asterisk <-> LiveKit, usuario fijo "livekit". Va en los dos
# trunks de LiveKit (`make livekit-sip`) y en pjsip.conf. Generar con
# `openssl rand -hex 24` (solo hex: un `$` se interpola en docker-compose).
LIVEKIT_SIP_PASSWORD=
#
# IP publica (o hostname de DDNS) que Asterisk anuncia a Anura y a LiveKit.
# Vacio = se autodetecta al arrancar. Si la IP del ISP es dinamica conviene un
# DDNS: si cambia hay que reiniciar Asterisk y volver a correr `make livekit-sip`.
ASTERISK_PUBLIC_ADDRESS=
# Puertos que el router tiene que redirigir (UDP) a este host: SIP de LiveKit y
# el rango RTP. 5080 y no 5060 para esquivar el grueso de los escaneos
# automaticos de SIP en internet.
ASTERISK_SIP_PORT=5080
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10199
# Puerto SIP local para Anura. NO se redirige en el router: Anura entra por el
# agujero que abre el registro en el NAT.
ASTERISK_ANURA_SIP_PORT=5081

# --- Eval de calidad del LLM (make eval-llm, docs/EVAL_LLM_PLAN.md) ---
# Cliente simulado y juez: un LLM externo OpenAI-compatible, mas grande que el
# agente evaluado. Default: DeepSeek directo. Con OpenRouter, la base de abajo y el
# modelo con prefijo de proveedor (ver openrouter.ai/models). Con --cliente guion
# no hace falta.
#EVAL_LLM_BASE_URL=https://api.deepseek.com/v1
#EVAL_LLM_API_KEY=
#EVAL_LLM_MODEL=deepseek-chat
# OpenRouter:
#EVAL_LLM_BASE_URL=https://openrouter.ai/api/v1
#EVAL_LLM_MODEL=deepseek/deepseek-v3.2

# --- Agente por defecto (slug de una plantilla, app/agents/templates/<id>.json) ---
# Los agentes viven en la base, por cliente (UI > Agentes). Este slug lo usan el
# seed (agente que atiende ANURA_DID en el cliente interno) y el loadtest (--workflow).
WORKFLOW_ID=demo_booking_classic

# --- UI y API: sesiones, admin inicial y limites ---
# Firma de las sesiones (JWT). Obligatoria: `openssl rand -hex 32`.
AUTH_SECRET=
# Cookie de sesion con Secure. true: siempre. false: solo si el pedido llega por HTTPS
# (tunel de app.atentina.com.ar); asi tambien anda en http://localhost:8011.
AUTH_COOKIE_SECURE=false
# Pares de los que se cree CF-Connecting-IP y X-Forwarded-Proto. `gateway` = el gateway por
# defecto del contenedor (el de la red de compose, por donde llega cloudflared; hoy 172.24.0.1).
#TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,gateway
# Origenes del dashboard para pedidos con la cookie (CSRF), ademas del mismo Host.
#APP_ORIGINS=https://app.atentina.com.ar
# /api/v1/docs y openapi.json: admin (default), public u off.
#API_DOCS=admin
# true: la CSP va como Report-Only (para probar el SDK de Facebook sin romper la UI).
#CSP_REPORT_ONLY=false
# Logins fallidos: por IP + email y por email en 15 min; por IP en 15 min y por dia. El de
# email solo frena a las IP que ya fallaron (un tercero no deja afuera al dueno).
#LOGIN_FAIL_IP_EMAIL_15M=5
#LOGIN_FAIL_IP_15M=20
#LOGIN_FAIL_IP_DAY=100
#LOGIN_FAIL_EMAIL_15M=10
# Tope del cuerpo de los pedidos a /api (bytes).
#API_MAX_BODY_BYTES=1048576
# Por usuario o API key, por hora: prueba de voz, conversaciones de texto nuevas y sus turnos.
#RATE_TTS_PREVIEW_PER_HOUR=60
#RATE_CONVERSATIONS_PER_HOUR=60
#RATE_TURNS_PER_HOUR=600
# Cliente (slug) que puede pedir llamadas de loadtest, ademas de los admins.
#LOADTEST_CLIENT=interno
# Admin que crea `make migrate` si no existe (despues: make create-admin EMAIL=...).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# El mes de consumo de los tiers empieza el 1 a las 00:00 en esta zona.
#BILLING_TIMEZONE=America/Argentina/Buenos_Aires
# API key del cliente con que corren el loadtest y el test de capacidad
# (make api-key CLIENT=interno NAME=loadtest).
VAAS_API_KEY=

# --- Base de datos: credenciales del contenedor PostgreSQL ---
# Se usan para configurar el servicio `db` y para armar el DB_DSN de `app` y
# `agent` (docker-compose.yml). Mantener POSTGRES_PASSWORD solo con
# alfanumericos/guion/guion_bajo -- se interpola directo en una URL de DSN y
# caracteres como @ / : # % la rompen.
POSTGRES_DB=aiva_validate
POSTGRES_USER=aiva_validate
POSTGRES_PASSWORD=changeme

# --- Solo Docker Compose: UID/GID de build para el usuario no-root del app ---
# Solo importa para el bind mount de storage/. Por defecto 1000:1000 si no se
# define (coincide con la mayoria de las maquinas Linux de un solo usuario).
# Descomentar y setear al resultado de `id -u`/`id -g` si difieren en tu
# maquina, para evitar errores de permisos en storage/recordings.
#UID=1000
#GID=1000

# --- Demo de la landing (/api/v1/demo, docs/LANDING.md) ---
# Secret de Cloudflare Turnstile. Sin el, la demo responde 503. Para probar en
# local: 1x0000000000000000000000000000000AA (siempre valida).
TURNSTILE_SECRET_KEY=
# Origenes que pueden llamar a la demo (CORS), separados por coma.
DEMO_ALLOWED_ORIGINS=https://atentina.com.ar,https://www.atentina.com.ar
# LiveKit que usa el navegador (por el tunel). Vacio: LIVEKIT_URL.
DEMO_LIVEKIT_URL=wss://rtc.atentina.com.ar
# Limites: llamada maxima, minutos por dia entre todas, y por IP.
# DEMO_CALL_MAX_SECONDS=180
# DEMO_JOIN_TIMEOUT_SECONDS=60
# DEMO_DAILY_MINUTES=120
# DEMO_IP_CALLS_PER_HOUR=4
# DEMO_IP_CALLS_PER_DAY=10
# DEMO_IP_TTS_PER_HOUR=30
# DEMO_IP_SESSIONS_PER_HOUR=20
# DEMO_TTS_MAX_CHARS=300

# --- Formulario de contacto de la landing (docs/LANDING.md) ---
# Aviso por mail con Resend. Sin clave o sin destino, el pedido se guarda igual en contact_requests.
RESEND_API_KEY=
CONTACT_TO=
# CONTACT_FROM=Atentina <web@atentina.com.ar>
# CONTACT_IP_PER_HOUR=3
# CONTACT_IP_PER_DAY=10
# Token del tunel de Cloudflare (docker-compose.tunnel.yml, make up-tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# --- WhatsApp (docs/WHATSAPP_PLAN.md, app/whatsapp/) ---
# ID de la app de Meta (developers.facebook.com > la app > Configuracion > Basica).
WA_APP_ID=
# Secreto de la app (misma pantalla). SECRETO: firma de los webhooks (X-Hub-Signature-256).
WA_APP_SECRET=
# Token de verificacion del webhook (GET /wa/webhook). Lo inventamos nosotros:
# openssl rand -hex 16. Se pega igual en la config del webhook en Meta.
WA_VERIFY_TOKEN=
# Token del system user del portafolio (Business Settings > Usuarios del sistema).
# SECRETO: permite enviar mensajes desde nuestros numeros.
WA_ACCESS_TOKEN=
# URL publica del webhook, por el tunel de Cloudflare (sin barra final).
WA_PUBLIC_URL=https://wa.atentina.com.ar
# Version de la Graph API.
WA_GRAPH_VERSION=v25.0
# Fase 2 (Embedded Signup): ID de la configuracion de Facebook Login for Business
# (la app > Facebook Login for Business > Configuraciones). Vacio: el boton queda deshabilitado.
WA_CONFIG_ID=
# Clave(s) Fernet para cifrar en la base los tokens y PIN de los clientes. SECRETO.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotar: la nueva primero, coma, la vieja.
WA_TOKEN_KEY=
# Altas por Embedded Signup y plantillas creadas, por cliente y por hora.
#WA_SIGNUP_PER_HOUR=10
#WA_TEMPLATES_PER_HOUR=20
# Idioma del SDK de Facebook.
#WA_SDK_LOCALE=es_LA
# Solo para scripts/wa.py (make wa-send): ID del numero emisor. Lo lee el script del entorno, no Settings.
WA_PHONE_NUMBER_ID=
# PIN de 6 dígitos de la verificación en dos pasos de nuestros números (POST /register). Secreto.
# Lo usa tambien "Reintentar registro" en cuentas de alta manual (sin token propio).
WA_REGISTRATION_PIN=
# Fase 1 (el agente responde por WhatsApp). Horas sin mensajes del cliente tras las que
# un mensaje nuevo abre otra conversacion (la ventana de servicio de Meta es de 24 h).
WA_SESSION_HOURS=24
# Segundos que se esperan para juntar mensajes seguidos ("hola" / "queria saber...") en un turno.
WA_DEBOUNCE_SECONDS=2.0
# Respuesta fija a imagenes, videos, documentos y otros no-texto (sin LLM). Los audios se transcriben.
WA_UNSUPPORTED_REPLY=Por ahora no puedo ver imágenes ni archivos. ¿Me lo escribís?
# Tope de caracteres de la respuesta (el de Meta es 4096; se trunca).
WA_MAX_REPLY_CHARS=4096
# Topes: caracteres por turno (lo que pase se descarta) y turnos por conversacion (despues
# abre otra), para no pasar el contexto del LLM ni dejar que un bot lo ocupe.
WA_MAX_TURN_CHARS=2000
WA_MAX_TURNS=40
# Audios: los entrantes se transcriben con el STT (VLLM_STT_*) y la respuesta puede salir
# como nota de voz con el TTS (VLLM_TTS_*, voz del agente). Cada turno con audio usa STT y TTS.
# Respuesta en audio: mirror (si el cliente mando algun audio en el turno), never o always.
WA_AUDIO_REPLY=mirror
# Topes del audio entrante: bytes (Meta permite hasta 16 MB) y segundos; si se pasa, respuesta fija.
WA_AUDIO_MAX_BYTES=4194304
WA_AUDIO_MAX_SECONDS=120
# Respuestas de mas caracteres salen en texto aunque correspondiera audio.
WA_AUDIO_MAX_REPLY_CHARS=600
# Pedidos simultaneos desde WhatsApp, a cada uno: STT y TTS (guarda para la 5060 Ti, sin medir).
WA_AUDIO_CONCURRENCY=4
# "voice": true al enviar el audio, para que se vea como nota de voz.
WA_AUDIO_VOICE_FLAG=true
WA_AUDIO_TOO_LONG_REPLY=Ese audio es muy largo para mí. ¿Me mandás uno más corto o me lo escribís?
WA_AUDIO_EMPTY_REPLY=No te escuché bien, ¿me lo repetís?
WA_AUDIO_ERROR_REPLY=No pude escuchar el audio. ¿Me lo escribís?
