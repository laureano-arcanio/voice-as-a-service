# Base de datos MySQL
# NOTA: este DB_DSN apunta a 127.0.0.1 para el deploy bare-metal/systemd (ver
# README.md). Al correr con `docker compose` este valor se IGNORA para el
# contenedor `app` -- docker-compose.yml arma su propio DB_DSN a partir de las
# variables MYSQL_* de abajo y apunta al servicio `db` en vez de 127.0.0.1.
DB_DSN=mysql+pymysql://aiva_validate:PASSWORD@127.0.0.1/aiva_validate?charset=utf8mb4

# --- Proveedor de voz: LiveKit Agents + troncal SIP saliente (Twilio) ---
# URL/keys del proyecto de LiveKit Cloud (Project Settings -> Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ID de la troncal SIP saliente (ST_...), creada una sola vez con `lk sip outbound
# create` (ver README para el runbook completo de Twilio + LiveKit).
LIVEKIT_SIP_TRUNK_ID=
# Nombre de ruteo del agente para el dispatch explicito (debe matchear EXACTO
# entre el proceso `app` que dispara la llamada y el proceso `agent` que la
# atiende). OJO: no confundir con AGENT_NAME de abajo (ese es el nombre de
# fantasia que dice el agente al hablar, ej. "Sofia"; este es el identificador
# tecnico de ruteo de LiveKit).
LIVEKIT_AGENT_NAME=aiva-outbound-caller
# Duracion maxima de una llamada antes de cortarla forzosamente.
CALL_MAX_DURATION_SECONDS=900

# --- Inferencia local (vLLM) ---
# LLM conversacional + STT + TTS + scoring, servidos por los contenedores
# vllm-llm/vllm-stt/vllm-tts de docker-compose.yml contra la GPU local -- ya no
# se usan proveedores externos (OpenAI/ElevenLabs/Anthropic). Los 3 hablan API
# compatible con OpenAI (mismo openai SDK que ya usaba livekit-agents antes,
# cambiando solo base_url/api_key).
#
# API key de mentira: estos endpoints no la validan, pero el openai SDK
# requiere que el campo no venga vacio.
VLLM_API_KEY=not-needed

# LLM: Qwen3.5-4B. /v1/chat/completions y /v1/responses -- swap directo de
# openai.responses.LLM(...).
VLLM_LLM_BASE_URL=http://vllm-llm:8000/v1
VLLM_LLM_MODEL=Qwen/Qwen3.5-4B
# Scoring (evaluacion del transcript al colgar, ver app/scoring.py): comparte
# el LLM de arriba por defecto. Descomentar para usar un modelo distinto si
# alguna vez se agrega otro al stack.
#VLLM_SCORING_MODEL=Qwen/Qwen3.5-4B

# STT: Qwen3-ASR-1.7B. /v1/audio/transcriptions (REST por-turno, sin partials
# como gpt-live-transcribe -- ver comentario en docker-compose.yml).
VLLM_STT_BASE_URL=http://vllm-stt:8000/v1
VLLM_STT_MODEL=Qwen/Qwen3-ASR-1.7B

# TTS: Qwen3-TTS-12Hz-1.7B-Base (checkpoint de voice-cloning), servido con
# vLLM-Omni. /v1/audio/speech (y /v1/audio/speech/stream) OpenAI-compatible --
# swap directo de elevenlabs.TTS(...) por openai.TTS(voice=..., ...).
#
# "sofia_ar" es una voz clonada (no un preset de fabrica): se subio UNA vez
# con audio real de una hablante argentina via POST /v1/audio/voices, ver
# comentario de vllm-tts en docker-compose.yml. Si esta variable no matchea
# ninguna voz subida (`GET /v1/audio/voices` contra vllm-tts para listarlas),
# la sintesis va a fallar -- hay que registrar la voz de nuevo con ese nombre.
VLLM_TTS_BASE_URL=http://vllm-tts:8000/v1
VLLM_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
VLLM_TTS_VOICE=sofia_ar
# OJO: probado que el server rechaza con 400 cualquier valor != 1.0 en modo
# streaming ("Streaming is not supported with speed adjustment") -- dejar en
# 1.0 salvo que se acepte perder streaming (mata la latencia de la llamada).
VLLM_TTS_SPEED=1.0

# Token de HuggingFace, solo si alguno de los 3 modelos de arriba requiere
# aceptar licencia/estar gateado (los de Qwen elegidos aca no lo requieren
# hoy). Se pasa a los 3 contenedores vllm-*.
HF_TOKEN=

# --- Personalizacion del demo ---
AGENT_NAME=Sofia
DEALERSHIP_NAME=Forest Car

# --- Solo Docker Compose: credenciales del contenedor MySQL ---
# Se usan para configurar el servicio `db` y para armar el DB_DSN de arriba
# dentro del contenedor `app`. Mantener MYSQL_PASSWORD solo con
# alfanumericos/guion/guion_bajo -- se interpola directo en una URL de DSN y
# caracteres como @ / : # % la rompen.
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=aiva_validate
MYSQL_USER=aiva_validate
MYSQL_PASSWORD=changeme

# --- Solo Docker Compose: UID/GID de build para el usuario no-root del app ---
# Solo importa para el bind mount de storage/. Por defecto 1000:1000 si no se
# define (coincide con la mayoria de las maquinas Linux de un solo usuario).
# Descomentar y setear al resultado de `id -u`/`id -g` si difieren en tu
# maquina, para evitar errores de permisos en storage/recordings.
#UID=1000
#GID=1000
