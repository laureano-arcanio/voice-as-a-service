# Entorno de desarrollo (docs/DESARROLLO.md). `make dev-env` crea .env.dev desde este archivo y completa los __...__.
# No poner credenciales de producción: sin claves, la app no manda mails ni WhatsApp y no cobra.
DEV_HOST=__DEV_HOST__
DEV_PORT=8211
APP_URL=http://__DEV_HOST__:8211
APP_ORIGINS=http://__DEV_HOST__:8211
AUTH_SECRET=__RANDOM__
AUTH_COOKIE_SECURE=false
API_DOCS=public
ADMIN_EMAIL=dev@atentina.com.ar
ADMIN_PASSWORD=__RANDOM__
POSTGRES_DB=atentina_dev
POSTGRES_USER=atentina
POSTGRES_PASSWORD=__RANDOM__
TOOLS_RUNNER_TOKEN=__RANDOM__
WA_TOKEN_KEY=__WA_TOKEN_KEY__

# LiveKit del entorno: el worker le habla por la red de compose y el navegador por el host.
LIVEKIT_URL=ws://livekit:7880
DEMO_LIVEKIT_URL=ws://__DEV_HOST__:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=__RANDOM__
LIVEKIT_AGENT_NAME=atentina-dev

# Modelos de este host, por su puerto en la LAN. Mismo modelo y muestreo que docker-compose.gemma4-26b.yml y .env.
VLLM_API_KEY=__VLLM_API_KEY__
VLLM_LLM_BASE_URL=http://__DEV_HOST__:8101/v1
VLLM_LLM_MODEL=cyankiwi/gemma-4-26B-A4B-it-qat-AWQ-INT4
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=64
LLM_MIN_P=0.0
LLM_THINKING=false
LLM_THINKING_BUDGET=128
VLLM_STT_BASE_URL=http://__DEV_HOST__:8102/v1
VLLM_STT_MODEL=__VLLM_STT_MODEL__
VLLM_TTS_BASE_URL=http://__DEV_HOST__:8103/v1
VLLM_TTS_MODEL=__VLLM_TTS_MODEL__
VLLM_TTS_VOICE=__VLLM_TTS_VOICE__

# --- Workflows del agente y derivacion por WhatsApp (valores sin medir) ---
# Barrido del post-call, y cuanto espera la entrega al operador a que termine.
#WORKFLOW_TICK_SECONDS=10
#POST_CALL_WAIT_SECONDS=3
# Rotacion por WhatsApp: barrido, tope de un toque tardio y reenvio al operador que la tomo.
#WA_HANDOFF_TICK_SECONDS=10
#WA_HANDOFF_LATE_MINUTES=30
#WA_HANDOFF_RELAY_HOURS=24
# Respuesta fija a una persona del equipo que escribe al numero de avisos, y por cuantas horas desde el aviso.
#WA_TEAM_NOTICE_HOURS=24
#WA_TEAM_REPLY=Este número solo envía avisos. Respondele a la persona desde tu WhatsApp.
